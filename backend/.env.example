# ─── Server ─────────────────────────────────────────
PORT=3001
NODE_ENV=development

# ─── Database ───────────────────────────────────────
# PostgreSQL — Neon, Supabase, GCP Cloud SQL, or Azure PostgreSQL
DATABASE_URL=postgresql://user:password@localhost:5432/sentinel

# ─── Auth ───────────────────────────────────────────
JWT_SECRET=change-this-to-a-long-random-string-in-production
AGENT_API_KEY=change-this-to-a-secret-key-shared-with-agents

# ─── Frontend ──────────────────────────────────────
FRONTEND_URL=http://localhost:5173

# ─── Billing Provider Selection ─────────────────────
# Which billing provider to use: stripe | paddle | lemonsqueezy
BILLING_PROVIDER=stripe

# ─── Stripe ─────────────────────────────────────────
# Get from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
# Price IDs from Stripe Dashboard → Products
STRIPE_PRICE_STARTER=price_xxx
STRIPE_PRICE_PRO=price_xxx
STRIPE_PRICE_BUSINESS=price_xxx

# ─── Paddle ─────────────────────────────────────────
# Get from https://vendors.paddle.com → Developer Tools → Authentication
PADDLE_API_KEY=pdl_xxx
PADDLE_WEBHOOK_SECRET=pdl_xxx
PADDLE_ENV=sandbox
# Price IDs from Paddle Dashboard → Catalog → Products
PADDLE_PRICE_STARTER=pri_xxx
PADDLE_PRICE_PRO=pri_xxx
PADDLE_PRICE_BUSINESS=pri_xxx

# ─── Lemon Squeezy ──────────────────────────────────
# Get from https://app.lemonsqueezy.com/settings/api
LEMONSQUEEZY_API_KEY=eyJxxx
LEMONSQUEEZY_WEBHOOK_SECRET=xxx
LEMONSQUEEZY_STORE_ID=12345
# Variant IDs from Lemon Squeezy → Store → Products → Variants
LEMONSQUEEZY_VARIANT_STARTER=xxxxx
LEMONSQUEEZY_VARIANT_PRO=xxxxx
LEMONSQUEEZY_VARIANT_BUSINESS=xxxxx

# ─── Alerts (optional) ──────────────────────────────
SENDGRID_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
ALERT_EMAIL=admin@yourcompany.com
